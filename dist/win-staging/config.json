{
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "cors": true,
    "environment": "production"
  },
  "ollama": {
    "host": "http://127.0.0.1:11434",
    "timeout_seconds": 120,
    "auto_pull_recommended": false
  },
  "workspace": {
    "data_directory": ".\\data",
    "backup_directory": ".\\data\\.backups",
    "max_file_size_bytes": 10485760,
    "allowed_extensions": [".md", ".txt", ".json", ".js", ".ts", ".py", ".html", ".css", ".csv", ".yaml", ".yml", ".xml", ".ini", ".env", ".bat", ".cmd", ".ps1"]
  },
  "windows": {
    "open_browser_on_launch": true,
    "tray_icon": true,
    "service_name": "Mini-O",
    "default_model": "llama3.1:8b"
  }
}
