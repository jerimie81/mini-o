[Unit]
Description=Mini-O Local AI Workspace Server
Documentation=https://github.com/redrum-ai/mini-o
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mini-o
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=MINI_O_DATA_DIR=/var/lib/mini-o
ExecStart=/usr/bin/node /opt/mini-o/dist/server.cjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mini-o

# Security sandboxing
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/mini-o /var/log/mini-o /tmp

[Install]
WantedBy=multi-user.target
