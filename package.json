{
  "name": "mini-o",
  "version": "0.1.0",
  "description": "Mini-O — local AI workspace",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "prestart": "npm run build",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:deb": "bash scripts/build-deb.sh",
    "build:windows": "bash scripts/build-windows.sh",
    "build:all": "bash scripts/build-all.sh",
    "package:all": "bash scripts/build-all.sh",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
